# Public app URL used for metadata / absolute links
NEXT_PUBLIC_APP_URL=https://biotech-laboratory.com

# Server-only certificate archive origin. Never expose this to the browser
# (do not prefix with NEXT_PUBLIC_).
CERTIFICATES_API_BASE_URL=https://api.omavilabs.com

# Optional Site 1 credentials used only by the Vercel/server proxy
# CERTIFICATES_API_TOKEN=
# CERTIFICATES_API_KEY=

# Optional extra hosts whose certificate file URLs may be fetched server-side
# CERTIFICATES_FILE_HOSTS=
